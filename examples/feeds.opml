<?xml version="1.0" encoding="UTF-8"?>
<opml version="2.0">
  <head>
    <title>Passband - example feed layout</title>
    <dateCreated>2026-06-01</dateCreated>
  </head>
  <body>

    <!-- ============================================================ -->
    <!-- RISK CORE                                                       -->
    <!-- Cyber threat intel + hazard/disaster. CISA retired all RSS  -->
    <!-- on 2025-05-12; SANS ISC + vendor blogs replace it.          -->
    <!-- ============================================================ -->
    <outline text="Risk - Cyber Threat Intel" title="Risk - Cyber Threat Intel">
      <outline type="rss" text="SANS Internet Storm Center" title="SANS Internet Storm Center"
               xmlUrl="https://isc.sans.edu/rssfeed.xml" htmlUrl="https://isc.sans.edu/"/>
      <outline type="rss" text="The Hacker News" title="The Hacker News"
               xmlUrl="https://feeds.feedburner.com/TheHackersNews" htmlUrl="https://thehackernews.com/"/>
      <outline type="rss" text="BleepingComputer" title="BleepingComputer"
               xmlUrl="https://www.bleepingcomputer.com/feed/" htmlUrl="https://www.bleepingcomputer.com/"/>
      <outline type="rss" text="Krebs on Security" title="Krebs on Security"
               xmlUrl="https://krebsonsecurity.com/feed/" htmlUrl="https://krebsonsecurity.com/"/>
      <outline type="rss" text="The Record (Recorded Future)" title="The Record (Recorded Future)"
               xmlUrl="https://therecord.media/feed/" htmlUrl="https://therecord.media/"/>
      <outline type="rss" text="Dark Reading" title="Dark Reading"
               xmlUrl="https://www.darkreading.com/rss.xml" htmlUrl="https://www.darkreading.com/"/>
      <outline type="rss" text="Schneier on Security" title="Schneier on Security"
               xmlUrl="https://www.schneier.com/feed/atom/" htmlUrl="https://www.schneier.com/"/>
      <outline type="rss" text="Google Project Zero" title="Google Project Zero"
               xmlUrl="https://projectzero.google/feed.xml" htmlUrl="https://projectzero.google/"/>
      <outline type="rss" text="Trail of Bits Blog" title="Trail of Bits Blog"
               xmlUrl="https://blog.trailofbits.com/feed/" htmlUrl="https://blog.trailofbits.com/"/>
      <outline type="rss" text="The Citizen Lab" title="The Citizen Lab"
               xmlUrl="https://citizenlab.ca/feed/" htmlUrl="https://citizenlab.ca/"/>
      <outline type="rss" text="Risky Business News" title="Risky Business News"
               xmlUrl="https://risky.biz/feeds/risky-business-news/" htmlUrl="https://risky.biz/"/>
    </outline>

    <outline text="Risk - Hazard &amp; Disaster" title="Risk - Hazard &amp; Disaster">
      <outline type="rss" text="NWS Active Alerts - Texas" title="NWS Active Alerts - Texas"
               xmlUrl="https://api.weather.gov/alerts/active.atom?area=TX" htmlUrl="https://www.weather.gov/"/>
      <outline type="rss" text="USGS Earthquakes M2.5+ (24h)" title="USGS Earthquakes M2.5+ (24h)"
               xmlUrl="https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/2.5_day.atom" htmlUrl="https://earthquake.usgs.gov/"/>
      <outline type="rss" text="ReliefWeb Updates" title="ReliefWeb Updates"
               xmlUrl="https://reliefweb.int/updates/rss.xml" htmlUrl="https://reliefweb.int/"/>
      <outline type="rss" text="NHC Atlantic (Tropical Cyclones)" title="NHC Atlantic (Tropical Cyclones)"
               xmlUrl="https://www.nhc.noaa.gov/index-at.xml" htmlUrl="https://www.nhc.noaa.gov/"/>
      <outline type="rss" text="GDACS Global Disaster Alerts" title="GDACS Global Disaster Alerts"
               xmlUrl="https://www.gdacs.org/xml/rss.xml" htmlUrl="https://www.gdacs.org/"/>
    </outline>

    <!-- ============================================================ -->
    <!-- RISK - GEOPOLITICAL & CONFLICT  (acute vector)              -->
    <!-- Acute vector. Daily, event-driven.                            -->
    <!-- ============================================================ -->
    <outline text="Risk - Geopolitical &amp; Conflict" title="Risk - Geopolitical &amp; Conflict">
      <outline type="rss" text="Institute for the Study of War" title="Institute for the Study of War"
               xmlUrl="https://www.iswresearch.org/feeds/posts/default" htmlUrl="https://www.understandingwar.org/"/>
      <outline type="rss" text="Crisis Group" title="Crisis Group"
               xmlUrl="https://www.crisisgroup.org/rss.xml" htmlUrl="https://www.crisisgroup.org/"/>
      <outline type="rss" text="FDD's Long War Journal" title="FDD's Long War Journal"
               xmlUrl="https://www.longwarjournal.org/feed" htmlUrl="https://www.longwarjournal.org/"/>
      <outline type="rss" text="Bellingcat" title="Bellingcat"
               xmlUrl="https://www.bellingcat.com/feed/" htmlUrl="https://www.bellingcat.com/"/>
      <outline type="rss" text="War on the Rocks" title="War on the Rocks"
               xmlUrl="https://warontherocks.com/feed/" htmlUrl="https://warontherocks.com/"/>
      <outline type="rss" text="Foreign Affairs" title="Foreign Affairs"
               xmlUrl="https://www.foreignaffairs.com/rss.xml" htmlUrl="https://www.foreignaffairs.com/"/>
      <outline type="rss" text="Foreign Policy" title="Foreign Policy"
               xmlUrl="https://foreignpolicy.com/feed/" htmlUrl="https://foreignpolicy.com/"/>
      <outline type="rss" text="Lawfare" title="Lawfare"
               xmlUrl="https://www.lawfaremedia.org/feed/" htmlUrl="https://www.lawfaremedia.org/"/>
    </outline>

    <!-- ============================================================ -->
    <!-- RISK - AVIATION & TRAVEL  (acute vector)                    -->
    <!-- ============================================================ -->
    <outline text="Risk - Aviation &amp; Travel" title="Risk - Aviation &amp; Travel">
      <outline type="rss" text="US State Dept Travel Advisories" title="US State Dept Travel Advisories"
               xmlUrl="https://travel.state.gov/_res/rss/TAsTWs.xml" htmlUrl="https://travel.state.gov/"/>
      <outline type="rss" text="The Aviation Herald" title="The Aviation Herald"
               xmlUrl="https://avherald.com/h?rss=true" htmlUrl="https://avherald.com/"/>
    </outline>

    <!-- ============================================================ -->
    <!-- STRUCTURAL SIGNALS (slow vector)                             -->
    <!-- Health, food/ag, energy, supply chain. Trend/trajectory      -->
    <!-- monitoring, not breaking events. Weekly cadence; separate    -->
    <!-- dashboard panel from the event-driven news + hazard flow.    -->
    <!-- ============================================================ -->
    <outline text="Signal - Global Health &amp; Disease" title="Signal - Global Health &amp; Disease">
      <outline type="rss" text="CIDRAP News (U. Minnesota)" title="CIDRAP News (U. Minnesota)"
               xmlUrl="https://www.cidrap.umn.edu/news/rss.xml" htmlUrl="https://www.cidrap.umn.edu/"/>
      <outline type="rss" text="CDC Current Outbreaks" title="CDC Current Outbreaks"
               xmlUrl="https://tools.cdc.gov/api/v2/resources/media/285676.rss" htmlUrl="https://www.cdc.gov/outbreaks/"/>
      <outline type="rss" text="STAT News" title="STAT News"
               xmlUrl="https://www.statnews.com/feed/" htmlUrl="https://www.statnews.com/"/>
    </outline>

    <outline text="Signal - Healthcare Industry" title="Signal - Healthcare Industry">
      <outline type="rss" text="Healthcare Dive" title="Healthcare Dive"
               xmlUrl="https://www.healthcaredive.com/feeds/news/" htmlUrl="https://www.healthcaredive.com/"/>
    </outline>

    <outline text="Signal - Agriculture &amp; Food" title="Signal - Agriculture &amp; Food">
      <outline type="rss" text="Food &amp; Environment Reporting Network (FERN)" title="Food &amp; Environment Reporting Network (FERN)"
               xmlUrl="https://thefern.org/feed/" htmlUrl="https://thefern.org/"/>
      <outline type="rss" text="Civil Eats" title="Civil Eats"
               xmlUrl="https://civileats.com/feed/" htmlUrl="https://civileats.com/"/>
    </outline>

    <outline text="Signal - Energy" title="Signal - Energy">
      <outline type="rss" text="EIA - Today in Energy" title="EIA - Today in Energy"
               xmlUrl="https://www.eia.gov/rss/todayinenergy.xml" htmlUrl="https://www.eia.gov/todayinenergy/"/>
      <outline type="rss" text="Utility Dive" title="Utility Dive"
               xmlUrl="https://www.utilitydive.com/feeds/news/" htmlUrl="https://www.utilitydive.com/"/>
    </outline>

    <outline text="Signal - Supply Chain &amp; Logistics" title="Signal - Supply Chain &amp; Logistics">
      <outline type="rss" text="Supply Chain Dive" title="Supply Chain Dive"
               xmlUrl="https://www.supplychaindive.com/feeds/news/" htmlUrl="https://www.supplychaindive.com/"/>
      <outline type="rss" text="FreightWaves" title="FreightWaves"
               xmlUrl="https://www.freightwaves.com/news/feed" htmlUrl="https://www.freightwaves.com/"/>
      <outline type="rss" text="gCaptain (Maritime)" title="gCaptain (Maritime)"
               xmlUrl="https://gcaptain.com/feed/" htmlUrl="https://gcaptain.com/"/>
    </outline>

    <outline text="Signal - Finance &amp; Macro" title="Signal - Finance &amp; Macro">
      <outline type="rss" text="Federal Reserve Press Releases" title="Federal Reserve Press Releases"
               xmlUrl="https://www.federalreserve.gov/feeds/press_all.xml" htmlUrl="https://www.federalreserve.gov/"/>
      <outline type="rss" text="Calculated Risk" title="Calculated Risk"
               xmlUrl="https://www.calculatedriskblog.com/feeds/posts/default" htmlUrl="https://www.calculatedriskblog.com/"/>
      <outline type="rss" text="Wolf Street" title="Wolf Street"
               xmlUrl="https://wolfstreet.com/feed/" htmlUrl="https://wolfstreet.com/"/>
      <outline type="rss" text="Artemis (Reinsurance / Cat Bonds)" title="Artemis (Reinsurance / Cat Bonds)"
               xmlUrl="https://www.artemis.bm/feed/" htmlUrl="https://www.artemis.bm/"/>
      <outline type="rss" text="The Big Picture (Ritholtz)" title="The Big Picture (Ritholtz)"
               xmlUrl="https://ritholtz.com/feed/" htmlUrl="https://ritholtz.com/"/>
      <outline type="rss" text="A Wealth of Common Sense" title="A Wealth of Common Sense"
               xmlUrl="https://awealthofcommonsense.com/feed/" htmlUrl="https://awealthofcommonsense.com/"/>
      <outline type="rss" text="Of Dollars and Data" title="Of Dollars and Data"
               xmlUrl="https://ofdollarsanddata.com/feed/" htmlUrl="https://ofdollarsanddata.com/"/>
      <outline type="rss" text="Klement on Investing" title="Klement on Investing"
               xmlUrl="https://klementoninvesting.substack.com/feed" htmlUrl="https://klementoninvesting.substack.com/"/>
    </outline>

    <outline text="Signal - Markets &amp; Equities" title="Signal - Markets &amp; Equities">
      <outline type="rss" text="CNBC Markets" title="CNBC Markets"
               xmlUrl="https://www.cnbc.com/id/20910258/device/rss/rss.html" htmlUrl="https://www.cnbc.com/markets/"/>
      <outline type="rss" text="CNBC Top News" title="CNBC Top News"
               xmlUrl="https://www.cnbc.com/id/100003114/device/rss/rss.html" htmlUrl="https://www.cnbc.com/"/>
      <outline type="rss" text="Investing.com Markets" title="Investing.com Markets"
               xmlUrl="https://www.investing.com/rss/news_25.rss" htmlUrl="https://www.investing.com/news/stock-market-news"/>
      <outline type="rss" text="MarketWatch Top Stories" title="MarketWatch Top Stories"
               xmlUrl="http://feeds.marketwatch.com/marketwatch/topstories/" htmlUrl="https://www.marketwatch.com/"/>
    </outline>

    <outline text="Signal - Climate &amp; Water" title="Signal - Climate &amp; Water">
      <outline type="rss" text="Carbon Brief" title="Carbon Brief"
               xmlUrl="https://www.carbonbrief.org/feed/" htmlUrl="https://www.carbonbrief.org/"/>
      <outline type="rss" text="Inside Climate News" title="Inside Climate News"
               xmlUrl="https://insideclimatenews.org/feed/" htmlUrl="https://insideclimatenews.org/"/>
      <outline type="rss" text="Circle of Blue (Water)" title="Circle of Blue (Water)"
               xmlUrl="https://www.circleofblue.org/feed/" htmlUrl="https://www.circleofblue.org/"/>
      <outline type="rss" text="Yale Climate Connections" title="Yale Climate Connections"
               xmlUrl="https://yaleclimateconnections.org/feed/" htmlUrl="https://yaleclimateconnections.org/"/>
    </outline>

    <!-- ============================================================ -->
    <!-- NEWS - LOCAL                                           -->
    <!-- ============================================================ -->
    <outline text="News - Local" title="News - Local">
      <outline type="rss" text="Fort Worth Report" title="Fort Worth Report"
