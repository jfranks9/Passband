      <outline type="rss" text="Dallas Innovates" title="Dallas Innovates"
               xmlUrl="https://dallasinnovates.com/feed/" htmlUrl="https://dallasinnovates.com/"/>
    </outline>

    <!-- ============================================================ -->
    <!-- NEWS - STATE                                                 -->
    <!-- ============================================================ -->
    <outline text="News - State" title="News - State">
      <outline type="rss" text="The Texas Tribune" title="The Texas Tribune"
               xmlUrl="https://feeds.texastribune.org/feeds/main/" htmlUrl="https://www.texastribune.org/"/>
      <outline type="rss" text="Texas Standard" title="Texas Standard"
               xmlUrl="https://texasstandard.org/feed/" htmlUrl="https://texasstandard.org/"/>
    </outline>

    <!-- ============================================================ -->
    <!-- NEWS - NATIONAL                                              -->
    <!-- ============================================================ -->
    <outline text="News - National" title="News - National">
      <outline type="rss" text="NPR News" title="NPR News"
               xmlUrl="https://feeds.npr.org/1001/rss.xml" htmlUrl="https://www.npr.org/"/>
      <outline type="rss" text="The Guardian - US" title="The Guardian - US"
