# Copy to .env and fill in. .env is gitignored. Nothing here is hardcoded in source.

# --- FreshRSS (Google Reader API) ---
# URL is the base of your FreshRSS instance, e.g. https://rss.example.com
FRESHRSS_URL=
FRESHRSS_USER=
# This is the "API password" set in FreshRSS > Settings > Profile (NOT your login password)
FRESHRSS_API_PASSWORD=

# --- LiteLLM (OpenAI-compatible proxy in front of your local models) ---
LITELLM_BASE_URL=http://localhost:4000
LITELLM_API_KEY=sk-local-anything

# --- Resend ---
RESEND_API_KEY=
NEWSLETTER_FROM=Risk Digest <digest@yourdomain.com>
NEWSLETTER_TO=you@example.com

# --- Location (keep it out of git) ---
# config/geo.yaml ships placeholders only. Set your real location here; these
# override the YAML. A malformed value is logged once and ignored, never fatal.
#
# [lat,lon] for the daily NWS forecast line. Unset = no forecast line.
# PASSBAND_FORECAST_POINT=<lat>,<lon>
# [min_lon,min_lat,max_lon,max_lat] for regional earthquake filtering.
# PASSBAND_BBOX=<min_lon>,<min_lat>,<max_lon>,<max_lat>
# Counties/place names that make a local NWS warning "yours" (alerts.yaml).
# PASSBAND_LOCAL_TERMS=County One, County Two
# State / metro / grid-operator terms gating watchlist rules marked `near: true`.
# PASSBAND_GEO_TERMS=your-state, your-metro
#
# NOTE: unlike the two above, LOCAL_TERMS and GEO_TERMS fail CLOSED. alerts.yaml
# ships placeholders that match nothing, so leaving these unset does not widen
# the alert layer — it silences it, while the newsletter keeps arriving normally.

# --- Optional: read-only MCP server (server.py) ---
# Exposes the gathered store to agents as `passband-news`. Defaults below are
# what the shipped compose assumes. A non-numeric port is logged and ignored
# rather than crashing the container at startup.
#
# The port must be FREE ON THE DEPLOY HOST. 8000 is a common default elsewhere;
# check with `ss -ltnp | grep :<port>` before settling on one.
# PASSBAND_MCP_HOST=0.0.0.0
# PASSBAND_MCP_PORT=8000
# Items one tool call pulls into memory before ranking.
# PASSBAND_MCP_POOL_CAP=2000

# --- Optional: place DB / output off the repo (e.g. fast local disk for cron) ---
# Set these once and don't move them afterwards: the store holds the sent-log,
# the rotation cursor and the trailing baselines that breakthrough detection is
# computed from. Pointing at a new path silently starts over.
# PASSBAND_DB_PATH=/var/lib/passband/passband.db
# PASSBAND_OUT_DIR=/var/lib/passband/out
